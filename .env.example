# Signal Forge Environment Configuration

# Database
DATABASE_URL=sqlite+aiosqlite:///./signal_forge.db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Keycloak
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=signal-forge
KEYCLOAK_CLIENT_ID=signal-forge-client
KEYCLOAK_CLIENT_SECRET=dev-secret-change-in-production

# LLM Provider (optional)
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# Debug
DEBUG=false